#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            //     Esc/L1   Tab      BkSp     /
            //     7        8        9        *
            //     4        5        6        -
            //     1        2        3        +
            //     0        .        =        Enter
            bindings = <
                &lt 1 ESC  &kp TAB    &kp BSPC   &kp KP_SLASH
                &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MULTIPLY
                &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS
                &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_PLUS
                &kp KP_N0  &kp KP_DOT &kp KP_EQUAL &kp KP_ENTER
            >;
        };

        layer1 {
            //     (held)   OUT_TOG  BT_CLR   trans
            //     BT_SEL0  BT_SEL1  BT_SEL2  trans
            //     trans    trans    trans    trans
            //     trans    trans    trans    trans
            //     unlock   trans    trans    trans
            bindings = <
                &trans        &out OUT_TOG  &bt BT_CLR    &trans
                &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans
                &trans        &trans        &trans        &trans
                &trans        &trans        &trans        &trans
                &studio_unlock &trans       &trans        &trans
            >;
        };
    };
};
