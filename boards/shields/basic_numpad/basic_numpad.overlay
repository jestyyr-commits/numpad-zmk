/*
 * shrug_zmk.overlay
 *
 * Direct-wired 20-key test board (nice!nano clone), no matrix/diodes.
 * Battery not connected yet -- fine, this is purely a USB-powered pin
 * test, same idea as the QMK A-T descramble test.
 *
 * IMPORTANT: this list is ordered by ACTUAL physical wiring (confirmed
 * via the descramble test), NOT the originally planned pin order. Entry
 * 0 = physical top-left key, reading left-to-right then top-to-bottom --
 * same convention as the keymap, so nothing needs remapping there.
 *
 * Real wiring, by physical grid position:
 *   Row1: 102, 029, 006, 106
 *   Row2: 107, 002, 008, 104
 *   Row3: 031, 115, 017, 011
 *   Row4: 009, 113, 020, 100
 *   Row5: 010, 111, 024, 022
 */

/ {
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        input-gpios
            = <&gpio1 2  GPIO_ACTIVE_LOW>   // 102 -- row1 col1
            , <&gpio0 29 GPIO_ACTIVE_LOW>   // 029 -- row1 col2
            , <&gpio0 6  GPIO_ACTIVE_LOW>   // 006 -- row1 col3
            , <&gpio1 6  GPIO_ACTIVE_LOW>   // 106 -- row1 col4
            , <&gpio1 7  GPIO_ACTIVE_LOW>   // 107 -- row2 col1
            , <&gpio0 2  GPIO_ACTIVE_LOW>   // 002 -- row2 col2
            , <&gpio0 8  GPIO_ACTIVE_LOW>   // 008 -- row2 col3
            , <&gpio1 4  GPIO_ACTIVE_LOW>   // 104 -- row2 col4
            , <&gpio0 31 GPIO_ACTIVE_LOW>   // 031 -- row3 col1
            , <&gpio1 15 GPIO_ACTIVE_LOW>   // 115 -- row3 col2
            , <&gpio0 17 GPIO_ACTIVE_LOW>   // 017 -- row3 col3
            , <&gpio0 11 GPIO_ACTIVE_LOW>   // 011 -- row3 col4
            , <&gpio0 9  GPIO_ACTIVE_LOW>   // 009 -- row4 col1
            , <&gpio1 13 GPIO_ACTIVE_LOW>   // 113 -- row4 col2
            , <&gpio0 20 GPIO_ACTIVE_LOW>   // 020 -- row4 col3
            , <&gpio1 0  GPIO_ACTIVE_LOW>   // 100 -- row4 col4
            , <&gpio0 10 GPIO_ACTIVE_LOW>   // 010 -- row5 col1
            , <&gpio1 11 GPIO_ACTIVE_LOW>   // 111 -- row5 col2
            , <&gpio0 24 GPIO_ACTIVE_LOW>   // 024 -- row5 col3
            , <&gpio0 22 GPIO_ACTIVE_LOW>   // 022 -- row5 col4
            ;
    };
};

